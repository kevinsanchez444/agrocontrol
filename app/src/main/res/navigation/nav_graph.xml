<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.agentes.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_FinanzasFragment"
            app:destination="@id/FinanzasFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.agentes.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
    <fragment
        android:id="@+id/FinanzasFragment"
        android:name="com.example.agentes.finanzas.FinanzasFragment"
        android:label="@string/finanzas_titulo"
        tools:layout="@layout/fragment_finanzas">

        <argument
            android:name="loteId"
            android:defaultValue="demo-lote-la-albania"
            app:argType="string" />
        <argument
            android:name="loteNombre"
            android:defaultValue="Lote La Albania"
            app:argType="string" />
    </fragment>
</navigation>