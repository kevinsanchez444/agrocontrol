<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/agro_surface"
    android:orientation="vertical"
    android:padding="@dimen/agro_card_padding"
    tools:context=".ui.login.RegistrarseFragment">

    <TextView
        android:id="@+id/texto_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/registro_titulo"
        android:textAppearance="@style/TextAgro.Title" />

    <TextView
        android:id="@+id/texto_descripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/registro_descripcion"
        android:textAppearance="@style/TextAgro.Muted" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_nombre"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/agro_card_gap"
        android:hint="@string/login_campo_nombre">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_correo"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/agro_gap_small"
        android:hint="@string/login_campo_correo">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/progress_carga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/agro_gap_small"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/agro_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/texto_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/agro_gap_small"
        android:gravity="center"
        android:textAppearance="@style/TextAgro.Muted"
        android:textColor="@color/agro_error"
        android:visibility="gone"
        tools:text="Ese correo ya está registrado."
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/agro_card_gap"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_cancelar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro_cancelar"
            android:textColor="@color/agro_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_registrarse"
            style="@style/Widget.Agro.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/agro_gap_small"
            android:text="@string/registro_boton" />
    </LinearLayout>

</LinearLayout>
