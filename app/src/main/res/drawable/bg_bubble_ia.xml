<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de la IA en el chat: paleta Agro, misma superficie que las
     tarjetas (blanco + borde 1dp) con esquina superior izquierda a 4dp
     (efecto de "cola"). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/agro_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/agro_outline" />
    <corners
        android:topLeftRadius="4dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="16dp" />
</shape>
